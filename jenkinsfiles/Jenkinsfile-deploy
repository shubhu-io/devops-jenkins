pipeline {
    agent any
    environment {
        DOCKER_IMAGE = "shubhu-io/sample-web-app:${BUILD_NUMBER}"
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/shubhu-io/07-devops-docker.git'
            }
        }
        stage('Build Docker Image') {
            steps {
                sh 'docker build -t ${DOCKER_IMAGE} .'
            }
        }
        stage('Security Scan') {
            steps {
                sh 'trivy image ${DOCKER_IMAGE} || true'
            }
        }
        stage('Deploy to Staging') {
            steps {
                echo "Deploying ${DOCKER_IMAGE} to staging environment..."
            }
        }
    }
}
